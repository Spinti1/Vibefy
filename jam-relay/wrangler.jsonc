{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vibefy-jam",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-05",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "JamRoom"
      },
      {
        "name": "SHARES",
        "class_name": "PlaylistShare"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "JamRoom"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "PlaylistShare"
      ]
    }
  ],
  "ratelimits": [
    {
      "name": "LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": false
  }
}
